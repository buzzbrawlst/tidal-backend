# Render / local environment variables
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
BACKEND_ADMIN_SECRET=replace-with-another-long-random-secret

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
DISCORD_REDIRECT_URI=https://tidal-backend-klp9.onrender.com/auth/callback

# Discord bot
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-server-id
ADMIN_ROLE_ID=your-discord-admin-role-id

# Tidal game services
BACKEND_URL=https://tidal-backend-klp9.onrender.com
TIDAL_FORTNITE_VERSION=12.41
TIDAL_BUILD_UNIQUE_ID=1:Tidal:12.41
GAME_SERVER_SECRET=replace-with-a-game-server-secret
